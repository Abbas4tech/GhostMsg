#!/bin/sh
set -e

# Check staged files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(ts|tsx|js|jsx|json|jsonc|md|css)$' || true)

if [ -z "$STAGED_FILES" ]; then
  echo "No lintable files staged"
  exit 0
fi

# Run ultracite on staged files (batched: large commits exceed the Windows
# command-line length limit when every path is passed to one invocation)
echo "$STAGED_FILES" | xargs -n 50 npx ultracite fix

# Re-stage fixed files
echo "$STAGED_FILES" | xargs -n 50 git add

echo "✨ Ultracite checks complete"
