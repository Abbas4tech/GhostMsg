# GhostMsg environment variables
#
# Copy to .env.local and fill in:  cp .env.example .env.local
# This file lists every variable the code reads (checked against every
# process.env / import.meta.env / env.X access in the repo). Never commit real
# values.
#
# Optional lines are commented out on purpose. Leave them commented rather than
# empty: an empty value counts as "set" and overrides the default
# (SMTP_PORT= would mean port 0).
#
# Reference with links to each read site: docs/02-getting-started.md §2
# Production checklist: docs/09-deployment-and-operations.md §2
#
# This file is for your own .env.local only. The Production and Preview
# copies of these variables on Vercel are managed by terraform/ (ADR 0032),
# not set by hand in the Vercel dashboard. See terraform/README.md.

# ------------------------------------------------------------------------------
# Database (required)
# ------------------------------------------------------------------------------
# Read in: src/server/db/db-connect.ts
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ghostmsg?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# Authentication: NextAuth v4 (required)
# ------------------------------------------------------------------------------
# Signs session JWTs. Generate with: openssl rand -base64 32
# Read in: src/app/api/auth/[...nextauth]/options.ts, src/middleware.ts,
#          src/server/security/security.ts (Sender Hash fallback)
NEXT_AUTH_SECRET=
# Public URL of the app: NextAuth callbacks (read by NextAuth itself) and links
# in emails (default there: https://ghost-msg.vercel.app).
# Read in: next-auth, src/server/email/mailer.ts
NEXTAUTH_URL=http://localhost:3000

# Google sign-in (optional; without it only email sign-up works).
# In Google Cloud, register the redirect URI <NEXTAUTH_URL>/api/auth/callback/google
# Read in: src/app/api/auth/[...nextauth]/options.ts
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...

# ------------------------------------------------------------------------------
# Email over SMTP (required for email sign-up: the verification code is emailed)
# ------------------------------------------------------------------------------
# Also sends instant alerts and daily digests.
# Examples: Gmail smtp.gmail.com + an app password; Brevo smtp-relay.brevo.com;
# Mailtrap sandbox.smtp.mailtrap.io for local testing.
# Read in: src/server/email/mailer.ts
SMTP_HOST=
# 587 = STARTTLS (default), 465 = TLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on emails (default: "GhostMsg 👻 <SMTP_USER>")
# SMTP_FROM="GhostMsg 👻 <noreply@example.com>"

# ------------------------------------------------------------------------------
# AI: Google AI Studio / Gemini (optional)
# ------------------------------------------------------------------------------
# Moderation, Sentiment Tags, Smart Reply, Suggested Messages and AMA ideas.
# Unset: every message is delivered as clean (nothing is quarantined) and the AI
# features use fixed fallbacks. The key is always passed explicitly, so the AI
# SDK's own GOOGLE_GENERATIVE_AI_API_KEY is never used.
# Read in: src/server/ai/moderation.ts, src/server/ai/smart-reply.ts,
#          src/server/ai/ama-suggestions.ts, src/app/api/suggest-messages/route.ts
# GOOGLE_AI_STUDIO_SECRET=AIzaSy...

# ------------------------------------------------------------------------------
# Web Push: VAPID keys (optional)
# ------------------------------------------------------------------------------
# Generate both with: npx web-push generate-vapid-keys
# Unset: Settings says push isn't configured and the server sends no pushes.
# The public key is built into the browser bundle: change it, then rebuild.
# Rotating the private key invalidates every saved device subscription.
# Read in: src/data/user/use-push-notification.ts (public key, browser),
#          src/server/push/web-push.ts (all three, server)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
# VAPID_PRIVATE_KEY=...
# Contact for push services (default: mailto:support@ghostmsg.app)
# VAPID_SUBJECT=mailto:you@example.com

# ------------------------------------------------------------------------------
# Trust & safety (recommended in production)
# ------------------------------------------------------------------------------
# HMAC pepper for Sender Hashes. Falls back to NEXT_AUTH_SECRET when unset.
# Rotating it changes every future hash, so existing blocks stop matching.
# Read in: src/server/security/security.ts
# SENDER_PEPPER_SECRET=

# ------------------------------------------------------------------------------
# Daily digest scheduler (optional)
# ------------------------------------------------------------------------------
# Bearer secret for GET /api/cron/daily-digest; Vercel Cron sends it.
# Unset: the route answers 503 and no daily digests are sent.
# Read in: src/app/api/cron/daily-digest/route.ts
# CRON_SECRET=

# ------------------------------------------------------------------------------
# Tooling (optional)
# ------------------------------------------------------------------------------
# Bundle analyzer report on build. `pnpm analyze` sets it for you.
# Read in: next.config.ts
# ANALYZE=true

# ------------------------------------------------------------------------------
# Not needed here
# ------------------------------------------------------------------------------
# Set automatically:
#   NODE_ENV                   by Next.js (src/server/realtime/event-bus.ts)
#   MODE                       by Vite in Storybook (.storybook/preview.tsx)
#   VERCEL_*                   by Vercel (VERCEL_OIDC_TOKEN arrives via `vercel env pull`)
# Not read by the code (safe to delete from .env.local and Vercel):
#   RESEND_API_KEY             email moved to SMTP (ADR 0011)
#   GOOGLE_OAUTH_CALLBACK_URL  NextAuth derives it from NEXTAUTH_URL
#   GOOGLE_GENERATIVE_AI_API_KEY  the key above is passed explicitly
